# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (but keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

